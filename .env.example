# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/auto_poster

# API Configuration (optional - defaults are fine)
DEBUG=false

# =============================================================================
# Authentication & Security (REQUIRED)
# =============================================================================

# JWT Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin User (REQUIRED - for initial access)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecureAdminPassword123

# =============================================================================
# SMTP Email Configuration (REQUIRED for email verification)
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Auto Poster
SMTP_USE_TLS=true

# =============================================================================
# Other Configurations
# =============================================================================

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# Video Generation Settings
VIDEO_DURATION=15
SHORTS_DURATION=60

# MakerWorld Scraper Settings
MAKERWORLD_BASE_URL=https://makerworld.com
SCRAPER_TIMEOUT=60
HEADLESS_BROWSER=true
