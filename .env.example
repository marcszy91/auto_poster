# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/auto_poster

# API Configuration (optional - defaults are fine)
DEBUG=false

# Instagram Credentials (required)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# YouTube API Credentials (optional)
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# Groq AI API (optional - for text generation)
GROQ_API_KEY=your_groq_api_key

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# Video Generation Settings
VIDEO_DURATION=15
SHORTS_DURATION=60

# MakerWorld Scraper Settings
MAKERWORLD_BASE_URL=https://makerworld.com
SCRAPER_TIMEOUT=60
HEADLESS_BROWSER=true
